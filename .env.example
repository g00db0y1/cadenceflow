# ==============================================================================
# CadenceFlow — Clerk Auth & Supabase Configuration Placeholders
# ==============================================================================
# Pass these via --dart-define when running or building:
#   flutter run \
#     --dart-define=CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY \
#     --dart-define=CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev \
#     --dart-define=SUPABASE_URL=https://your-project-ref.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
#
# Note: When placeholders are left as-is, CadenceFlow automatically starts in
# Offline-First Local Mirror Mode so every feature works immediately on-device.

CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_FRONTEND_API=https://your-clerk-instance.clerk.accounts.dev
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_YOUR_SUPABASE_ANON_KEY
